# Neon Postgres connection string (Neon dashboard -> your project -> Connect)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Clerk (https://dashboard.clerk.com -> your app -> API keys)
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Also used server-side when verifying requests
CLERK_PUBLISHABLE_KEY=pk_test_...

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional model override (defaults to deepseek/deepseek-v4.1-flash — the
# flash models answer in under a second; larger models reason first and can
# take 10s+)
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional comma-separated fallback models if the primary is busy/rate-limited
# OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-v4-flash

# Port for the API/static server (Railway sets PORT automatically)
# PORT=3333

# Used when building the iOS/Android apps (Capacitor). Native builds fall
# back to the Railway URL below if this is unset. The web app can omit it.
# VITE_API_BASE_URL=https://clarity-notes-production.up.railway.app

# Extra CORS origins for native / preview hosts, comma-separated
# CORS_ORIGINS=https://your-custom-domain.com
