# Neon Postgres connection string (Neon dashboard -> your project -> Connect)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Clerk (https://dashboard.clerk.com -> your app -> API keys)
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Also used server-side when verifying requests
CLERK_PUBLISHABLE_KEY=pk_test_...

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...
# Optional model override (defaults to gemini-3.5-flash-lite — the lite
# models answer in under a second; the full flash models think first and
# can take 10s+ on a free-tier key)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional comma-separated fallback models if the primary is busy/quota-limited
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite

# Port for the API/static server (Railway sets PORT automatically)
# PORT=3333
